# Choose exactly one provider: ollama, openai, or anthropic.
SOVEREIGN_DEMO_PROVIDER=ollama

# Local option. No key leaves this machine.
OLLAMA_MODEL=qwen3:latest
OLLAMA_URL=http://localhost:11434/api/chat

# Cloud option 1. Create a project API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_URL=https://api.openai.com/v1/chat/completions

# Cloud option 2. Create an API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_URL=https://api.anthropic.com/v1/messages
